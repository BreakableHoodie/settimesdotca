# Same cooldown as the root and frontend .npmrc. This workspace needs its OWN
# copy: npm reads project config from the current directory and does NOT walk up
# to a parent, so the root .npmrc does not apply here. This directory was left
# unprotected when the setting was first added, and the omission was invisible
# to the scanner that prompted it -- a rule can flag a file with a bad value,
# never a file that is absent.
min-release-age=7
