legacy-peer-deps=true

# Refuse to RESOLVE a version published in the last 7 days. The defence is
# against a compromised publish (the event-stream / xz class), where the window
# between a malicious version going up and being pulled is measured in hours.
# `npm ci` installs pinned versions from the lockfile and is unaffected; this
# only constrains `npm install` picking something new.
min-release-age=7
