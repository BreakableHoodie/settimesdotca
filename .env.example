# SetTimes runtime environment example
#
# Copy this file to .dev.vars for local Wrangler runs.
# Production values belong in Cloudflare Pages -> Settings -> Environment Variables.
#
# Admin authentication is per-user and stored in D1.
# Local seeded users are created by scripts/setup-local-db.sh.

# ============================================
# CORE RUNTIME
# ============================================

# Set to production in the deployed Pages environment.
ENVIRONMENT=development

# Base URL used in activation, reset, and subscription links.
PUBLIC_URL=http://localhost:8788

# Public event APIs stay disabled unless this is explicitly true.
PUBLIC_DATA_PUBLISH_ENABLED=false

# Public schedule cache TTL in seconds.
SCHEDULE_CACHE_TTL_SECONDS=60

# ============================================
# SECURITY
# ============================================

# Production must set CSRF_SECRET.
# Local development falls back to a built-in secret if this is omitted.
# Generate with: openssl rand -hex 32
CSRF_SECRET=

# Set this before using TOTP MFA in any environment.
# Must be exactly 32 bytes (64 hex characters). Keep it stable — changing it
# invalidates all existing TOTP secrets and forces users to re-enroll.
# Generate with: openssl rand -hex 32
MFA_TOTP_ENCRYPTION_KEY=

# Leave false locally unless you are explicitly testing enforced CSP.
# In production, the app enforces CSP by default when ENVIRONMENT=production.
CSP_ENFORCE=false

# Optional comma-separated additions to the built-in CORS allow list.
CORS_ALLOWED_ORIGINS=

# Non-production only. Enables bearer-header auth for trusted automation.
ALLOW_HEADER_AUTH=false

# ============================================
# EMAIL DELIVERY
# ============================================

# Leave blank unless you are testing activation, reset, or subscription emails.
# Supported values: postmark, mailchannels, resend
EMAIL_PROVIDER=

# Preferred sender address for transactional email.
EMAIL_FROM=

# Optional fallback sender if EMAIL_FROM is not set.
ADMIN_EMAIL=

# Required when EMAIL_PROVIDER=postmark
POSTMARK_API_TOKEN=

# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ============================================
# DIAGNOSTICS
# ============================================

# Supported values: debug, info, warn, error
LOG_LEVEL=debug

# ============================================
# TESTING NOTES
# ============================================

# Playwright/e2e credentials are regular shell env vars, not Wrangler vars.
# Export these in your terminal when needed:
#   E2E_ADMIN_EMAIL=admin@settimes.ca
#   E2E_ADMIN_PASSWORD=<local seeded password>
