{
  "name": "settimes-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "validate:schema": "cd .. && node scripts/validate-db-schema.js",
    "dev": "vite",
    "build": "npm run validate:schema && vite build",
    "preview": "vite preview",
    "analyze": "vite-bundle-visualizer",
    "deploy:dev": "cd .. && npm run deploy:dev",
    "deploy:prod": "cd .. && npm run deploy:prod",
    "psi": "node scripts/run-psi.mjs",
    "psi:dev": "npm run psi -- --url https://dev.settimesdotca.pages.dev",
    "psi:prod": "npm run psi -- --url https://settimes.ca",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 5",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:a11y": "vitest run src/test/a11y.test.jsx",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lhci autorun",
    "quality": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "dompurify": "^3.4.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "baseline-browser-mapping": "^2.11.14",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.2.2",
    "terser": "^5.50.0",
    "vite": "^8.2.1",
    "vite-bundle-visualizer": "^1.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "@lhci/cli": {
      "chrome-launcher": "1.2.1",
      "tmp": "0.2.7",
      "uuid": "14.0.0"
    },
    "external-editor": {
      "tmp": "0.2.7"
    },
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "lighthouse": {
      "ws": "7.5.11"
    },
    "node-gyp": {
      "undici": "6.28.0"
    },
    "@babel/core": "7.29.6",
    "@puppeteer/browsers": "3.2.0",
    "basic-ftp": "5.3.1",
    "brace-expansion": "5.0.7",
    "esbuild": "0.28.1",
    "sharp": "0.35.3",
    "js-yaml": "^4.3.1",
    "ajv": "^6.14.0"
  }
}
