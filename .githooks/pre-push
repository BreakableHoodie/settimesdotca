#!/bin/sh
# Guard against CodeRabbit rate-limit overage.
#
# CodeRabbit allows a dynamic number of PR reviews per ROLLING HOUR (see LIMIT
# below). Every push to a PR branch is a review. Past the allowance the review
# is RATE-LIMITED: CodeRabbit posts a notice instead of reviewing, and nothing
# re-runs it when the window refills -- the head commit stays unreviewed until
# someone comments `@coderabbitai review` -- which `make await-review PR=<n>`
# does after the cooldown. (Until 2026-09-24 the usage-based
# add-on was enabled and an over-limit review BILLED instead; it is now off.)
#
# The expensive failure is CONCENTRATION, not volume: five pushes across a day
# cost nothing, four in half an hour leaves a commit unreviewed. PR #998 burned 4 reviews in ~25
# minutes on a two-line change, because fixes were pushed one at a time instead
# of batched.
#
# WAITING IS FREE. The window is rolling, so the budget refills on its own.
# Override only when landing NOW actually matters -- a show-day fix, a
# production incident, or someone blocked on you:
#
#     CODERABBIT_OVERAGE=1 git push
#
# POSIX sh, and it makes exactly ONE optional network call: asking `gh`
# whether each pushed branch's PR is a draft. CodeRabbit never reviews drafts
# (`auto_review.drafts: false`), and CLAUDE.md says to iterate as a draft, so
# counting draft pushes blocked the very workflow the budget rules recommend.
#
# That lookup can only ever REMOVE a push from the count on an explicit
# "true". A missing `gh`, no network, no PR yet, an error, or a lookup slower
# than DRAFT_LOOKUP_SECONDS all count the push exactly as before. That is what
# keeps this from failing open: the earlier "no gh, no network" rule existed
# because a tool that goes quiet when it is missing is worse than none, and a
# lookup that fails TOWARD counting cannot go quiet. `make await-review` is
# the merge gate now; this hook only paces pushes.
#
# Known gap, unchanged: `gh pr ready` starts a review without a push, so the
# hook never sees it.

set -eu

WINDOW_SECONDS=3600

# The included allowance is DYNAMIC. Read it; never recall it.
#
# CodeRabbit states the current figure in the footer of every review it posts,
# and this account (plan: Essentials) has been observed at two different values:
#
#   2026-09-04, PR #1113:
#     "0 reviews are currently available. Your included PR review attempts over
#      the past 7 days set your current allowance at 1 review per hour."
#
#   2026-09-09, PR #1134:
#     "3 reviews are currently available. Your included PR review attempts over
#      the past 7 days set your current allowance at 4 reviews per hour."
#
#   2026-09-10, PR #1154:
#     "0 reviews are currently available. Your included PR review attempts over
#      the past 7 days set your current allowance at 3 reviews per hour."
#
#   2026-09-22, PR #1182:
#     "3 reviews are currently available. Your included PR review attempts over
#      the past 7 days set your current allowance at 5 reviews per hour."
#
#   2026-09-24, PR #1200 (first reading after usage billing was switched off):
#     "0 reviews are currently available. Your included PR review attempts over
#      the past 7 days set your current allowance at 2 reviews per hour."
#
# Four readings, four different values -- 1, 4, 3, 5 -- which is the strongest
# evidence yet that no value written here survives. It fell from 4 to 3 as this
# week's usage rose, so it moves in BOTH directions.
#
# So the allowance recovers as 7-day usage falls, and no static number stays
# right. The hook cannot ask -- it is deliberately POSIX sh with no gh, jq or
# network call, because one that fails open when a tool is missing is worse
# than no hook at all.
#
# LIMIT tracks the most recent observed footer. It was 1, then 4, then 3, then
# 5; it is 2 because 2026-09-24 says so. The rule is unchanged:
# move it only against a CURRENT footer, never from memory. The value being
# an OBSERVATION WITH A DATE is the point -- if these comments are stale, the
# number above them is too.
#
# Erring low is not free. Blocking a push when three reviews are genuinely
# available teaches you to reach for CODERABBIT_OVERAGE reflexively, and an
# override you always use is not a guard.
LIMIT=2
WARN_AT=2
DEFAULT_BRANCH=main
# Overridable only so the tests can exercise a hung lookup in about a second.
DRAFT_LOOKUP_SECONDS=${CODERABBIT_DRAFT_LOOKUP_SECONDS:-5}

# Prints "true" only when gh answers, in time, that <branch>'s PR is a draft.
# Anything else prints nothing, and the caller counts the push.
pr_is_draft() {
    command -v gh >/dev/null 2>&1 || return 0
    # Explicit template: a bare `mktemp` ignores TMPDIR on macOS.
    _out=$(mktemp "${TMPDIR:-/tmp}/coderabbit-draft.XXXXXX") || return 0
    gh pr view "$1" --json isDraft -q .isDraft </dev/null >"$_out" 2>/dev/null &
    _gh=$!
    # Bound it without `timeout`, which macOS does not ship. The watchdog's
    # own output is discarded so a lingering `sleep` cannot hold the hook's
    # stderr open after git expects it closed.
    # SIGKILL follows SIGTERM, because a process that ignores TERM would
    # otherwise hang the push indefinitely -- the #882 `timeout` without `-k`.
    ( sleep "$DRAFT_LOOKUP_SECONDS"; kill "$_gh" 2>/dev/null; sleep 1; kill -9 "$_gh" 2>/dev/null ) >/dev/null 2>&1 &
    _dog=$!
    # Capture gh's OWN status. `cmd || rc=$?` is the form that reads the
    # command's status (see CLAUDE.md, #882); it also keeps set -e from ending
    # this subshell before the cleanup below.
    _rc=0
    wait "$_gh" 2>/dev/null || _rc=$?
    kill "$_dog" 2>/dev/null || :
    # A draft only on success AND "true": output from a gh that then failed,
    # or was killed by the watchdog, is not an answer.
    [ "$_rc" -eq 0 ] && [ "$(cat "$_out")" = "true" ] && echo true
    rm -f "$_out"
    return 0
}

# pre-push receives one line per ref being updated on STDIN:
#
#     <local-ref> <local-sha> <remote-ref> <remote-sha>
#
# Read that rather than the checked-out branch. HEAD is the wrong signal: you
# can push a branch you are not on (`git push origin feat:feat` from main), push
# HEAD to a different remote branch, push several branches at once, or push a
# tag -- and each of those either misses a review or invents one.
#
# Eligible == a non-delete update to refs/heads/<anything but the default>.
# Tags and notes open no PR; a deletion (all-zero local sha) closes one.
eligible=0
eligible_refs=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -z "${remote_ref:-}" ] && continue

    case "$remote_ref" in
        "refs/heads/$DEFAULT_BRANCH") continue ;;
        refs/heads/*) ;;
        *) continue ;;
    esac

    case "${local_sha:-}" in
        *[!0]*) ;;
        *) continue ;;
    esac

    eligible=$((eligible + 1))
    eligible_refs="$eligible_refs${remote_ref#refs/heads/} "
done

# Drop branches whose PR is a draft: CodeRabbit will not review them.
if [ "$eligible" -gt 0 ]; then
    counted=""
    eligible=0
    for ref in $eligible_refs; do
        if [ "$(pr_is_draft "$ref")" = "true" ]; then
            printf '  CodeRabbit: %s is a draft PR -- not counted (drafts are not reviewed).\n' "$ref" >&2
            continue
        fi
        counted="$counted$ref "
        eligible=$((eligible + 1))
    done
    eligible_refs="$counted"
fi

# Nothing here triggers a review: a tag, a deletion, a push to the default
# branch, a push to a draft PR, or an invocation with no ref updates at all.
[ "$eligible" -eq 0 ] && exit 0

# The log is deliberately NOT in $GIT_DIR. CodeRabbit's allowance is per
# DEVELOPER, not per repository, so a per-repo counter under-counts the moment
# a second repo adopts this hook: three pushes here and three in another repo
# is six reviews against one shared budget, with neither hook noticing.
# Under-counting is the failure this guard exists to prevent, so the counter
# lives where the budget does -- one file for the whole account. This path is
# shared with BreakableHoodie/wrhn-mcp's hook, which fixed it first; keep the
# two identical or they stop seeing each other's pushes.
log="${XDG_CACHE_HOME:-$HOME/.cache}/coderabbit/push-log"
mkdir -p "$(dirname "$log")"
now=$(date +%s)
cutoff=$((now - WINDOW_SECONDS))

# Drop entries outside the rolling window before counting.
if [ -f "$log" ]; then
    awk -v c="$cutoff" '$1 >= c' "$log" > "$log.tmp" 2>/dev/null || : > "$log.tmp"
    mv "$log.tmp" "$log"
else
    : > "$log"
fi

count=$(wc -l < "$log" | tr -d ' ')
[ -z "$count" ] && count=0

if [ $((count + eligible)) -gt "$LIMIT" ]; then
    oldest=$(head -n 1 "$log" | cut -d' ' -f1)
    wait_min=$(( (oldest + WINDOW_SECONDS - now + 59) / 60 ))
    [ "$wait_min" -lt 1 ] && wait_min=1

    if [ "${CODERABBIT_OVERAGE:-}" = "1" ]; then
        printf '\n  ⚠  CodeRabbit: %s reviews already used this hour — this review will be RATE-LIMITED.\n' "$count" >&2
        printf '     Overriding because CODERABBIT_OVERAGE=1. Nothing re-runs the review for\n' >&2
        printf '     you: run  make await-review PR=<n>  and merge only when it exits 0.\n\n' >&2
    else
        printf '\n  ✋ Push blocked: %s CodeRabbit reviews used in the last hour (limit %s).\n\n' "$count" "$LIMIT" >&2
        printf '     The next review would exceed the window and be RATE-LIMITED (skipped).\n' >&2
        printf '     Waiting is free — the budget refills in ~%s min.\n\n' "$wait_min" >&2
        printf '     Batch your remaining fixes and push once.\n' >&2
        printf '     If this genuinely must land now (show day, incident, someone blocked):\n\n' >&2
        printf '         CODERABBIT_OVERAGE=1 git push\n\n' >&2
        exit 1
    fi
elif [ $((count + eligible)) -ge "$WARN_AT" ]; then
    remaining=$((LIMIT - count))
    printf '\n  ⚠  CodeRabbit: %s reviews used this hour, %s left before reviews are rate-limited.\n' "$count" "$remaining" >&2
    printf '     Batch what is left rather than pushing per fix.\n\n' >&2
fi

# Recorded BEFORE the remote accepts the push, which over-counts when a push is
# rejected or the network drops: a slot is consumed for a review that never ran.
# That is deliberate. git has no post-push hook, so the alternatives are to log
# here or to reconcile later against the remote-tracking ref -- and reconciling
# under-counts, because an amended commit that WAS pushed (and WAS reviewed)
# becomes unreachable after the next force-push.
#
# Over-counting costs an occasional spurious block, cleared for free by waiting
# or by CODERABBIT_OVERAGE=1. Under-counting leaves a commit unreviewed. Given
# the hook exists only to prevent the second, it errs toward the first on
# purpose.
# One entry per branch actually updated -- pushing two PR branches costs two.
for ref in $eligible_refs; do
    echo "$now $ref" >> "$log"
done
exit 0
