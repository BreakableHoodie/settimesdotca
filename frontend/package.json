{
  "name": "settimes-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "validate:schema": "cd .. && node scripts/validate-db-schema.js",
    "dev": "vite",
    "build": "npm run validate:schema && vite build",
    "preview": "vite preview",
    "analyze": "vite-bundle-visualizer",
    "deploy:dev": "cd .. && npm run deploy:dev",
    "deploy:prod": "cd .. && npm run deploy:prod",
    "psi": "node scripts/run-psi.mjs",
    "psi:dev": "npm run psi -- --url https://dev.settimesdotca.pages.dev",
    "psi:prod": "npm run psi -- --url https://settimes.ca",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:a11y": "vitest run src/test/a11y.test.jsx",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lhci autorun",
    "quality": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "dompurify": "^3.4.18",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "baseline-browser-mapping": "^2.11.39",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.2.2",
    "terser": "^5.51.4",
    "vite": "^8.3.8",
    "vite-bundle-visualizer": "^1.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "@lhci/cli": {
      "chrome-launcher": "1.2.1",
      "tmp": "0.2.7",
      "uuid": "14.0.0"
    },
    "external-editor": {
      "tmp": "0.2.7"
    },
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "lighthouse": {
      "ws": "7.5.11"
    },
    "@babel/core": "7.29.6",
    "@puppeteer/browsers": "3.2.0",
    "esbuild": "0.28.2",
    "js-yaml": "^4.3.2",
    "body-parser": {
      ".": "^1.20.9"
    },
    "undici@8": "^8.12.3",
    "zod@4": "^4.6.7",
    "ip-address": "^10.7.4",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "qs": "~6.16.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
